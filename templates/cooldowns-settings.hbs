<form>
  <div class="form-group">
    <label>是否启用 dnd5e 集成</label>
    <div class="form-fields">
      <input type="checkbox" name="enabled" {{#if enabled}}checked{{/if}} />
    </div>
  </div>

  <div class="form-group">
    <label>物品/技能 -> 冷却 映射（JSON）</label>
    <div class="form-fields">
      <textarea name="mapping" style="width:100%;height:240px;">{{mapping}}</textarea>
    </div>
  </div>

  <div class="form-group">
    <div class="form-fields">
      <button class="btn" data-action="test" type="button">测试映射</button>
      <button class="btn btn-primary" type="submit">保存</button>
    </div>
  </div>
</form>

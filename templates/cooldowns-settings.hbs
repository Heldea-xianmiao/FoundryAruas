<form>
  <div class="form-group">
    <label>{{localize "FOUNDRYAURAS.Settings.Cooldowns.Enable.Name"}}</label>
    <div class="form-fields">
      <input type="checkbox" name="enabled" {{#if enabled}}checked{{/if}} />
      <p class="notes">{{localize "FOUNDRYAURAS.Settings.Cooldowns.Enable.Hint"}}</p>
    </div>
  </div>

  <div class="form-group">
    <label>{{localize "FOUNDRYAURAS.Settings.Cooldowns.UseGlobalStorage.Name"}}</label>
    <div class="form-fields">
      <input type="checkbox" name="useGlobalStorage" {{#if useGlobalStorage}}checked{{/if}} />
      <p class="notes">{{localize "FOUNDRYAURAS.Settings.Cooldowns.UseGlobalStorage.Hint"}}</p>
    </div>
  </div>

  <div class="form-group">
    <label>{{localize "FOUNDRYAURAS.Settings.Cooldowns.Mapping.Name"}}</label>
    <div class="form-fields">
      <textarea name="mapping" style="width:100%;height:240px;">{{mapping}}</textarea>
      <p class="notes">{{localize "FOUNDRYAURAS.Settings.Cooldowns.Mapping.Hint"}}</p>
    </div>
  </div>

  <div class="form-group">
    <div class="form-fields">
      <button class="btn" data-action="test" type="button">{{localize "FOUNDRYAURAS.Settings.Cooldowns.TestButton"}}</button>
      <button class="btn btn-primary" type="submit">{{localize "FOUNDRYAURAS.Settings.Cooldowns.SaveButton"}}</button>
    </div>
  </div>
</form>
